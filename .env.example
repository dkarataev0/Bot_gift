# Пример переменных окружения. НЕ коммитьте настоящие значения!
# На Render они задаются в панели: Service → Environment.

# --- обязательные ---
BOT_TOKEN=            # токен от @BotFather
DATABASE_URL=         # строка подключения Supabase (Connect → Session pooler)

# --- доступ ---
ALLOWED_USER_IDS=     # ваш Telegram ID (через запятую можно несколько). Пусто: владельцем станет первый, кто напишет /start

# --- MTProto (username владельцев и макс. скорость) ---
TG_API_ID=            # https://my.telegram.org → API development tools
TG_API_HASH=
SESSION_SECRET=       # длинная случайная строка; ею шифруется сессия, сохранённая через /login
# TG_SESSION=         # альтернатива /login: строка сессии из `npm run login`

# --- необязательные настройки ---
# TZ_DISPLAY=Europe/Moscow
# DATABASE_SSL=true
# WEB_MAX_RPS=0.6          # t.me начинает отдавать пустые страницы при ~0.3+ запр/с с одного IP
# WEB_PROBE_MAX_RPS=1.5    # проверки «есть ли следующий номер» (ответ 302 ограничивается мягче)
# MTPROTO_MAX_RPS=4
# WORKERS=3
# HOT_INTERVAL_MS=3000
# WARM_INTERVAL_MS=20000
# COLD_INTERVAL_MS=90000
# MAX_FETCH_PER_TICK=25
# MAX_NOTIFY_WINDOW_MS=900000
# FAVORITES_RECHECK_MS=600000
# SEND_IMAGES=true        # превью подарка (картинка) в уведомлении
# RETENTION_DAYS=30        # сколько дней хранить историю (избранное хранится всегда)
# LOG_LEVEL=info
